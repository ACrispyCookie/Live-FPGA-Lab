# Copy to .env and adjust for the x86 deployment host.

# Host path that contains Vivado. It is mounted at the same absolute path inside
# the container because Xilinx settings scripts may source absolute install paths.
HOST_XILINX_DIR=/home/njason/Xilinx
FPGA_AGENT_VIVADO_SETTINGS=/home/njason/Xilinx/2025.2/Vivado/settings64.sh
FPGA_AGENT_XSDB=xsdb
FPGA_AGENT_VIVADO=vivado
FPGA_AGENT_TOOL_TIMEOUT_SECONDS=120
FPGA_AGENT_SOCKET=/run/fpga-agent/fpga-agent.sock
FPGA_DISCOVERY_INTERVAL_SECONDS=10
FPGA_TELEMETRY_INTERVAL_SECONDS=2
FPGA_OVER_TEMPERATURE_C=75
FPGA_OVER_TEMPERATURE_RECOVERY_C=60
FPGA_AGENT_MODE=DEMO

# Optional license server/file if Vivado needs one.
XILINXD_LICENSE_FILE=
LM_LICENSE_FILE=

# Current demo runtime. For current web-api proxy mode, leave these
# as localhost/random-port defaults. For Traefik direct-demo mode, use:
#   DEMO_HTTP_HOST=0.0.0.0
#   DEMO_HTTP_PORT=9130
DEMO_HOST_DIR=/home/njason/demos
DEMO_UART_PORT=/dev/ttyUSB1
DEMO_UART_BAUD=115200
DEMO_HTTP_HOST=127.0.0.1
DEMO_HTTP_PORT=9130

# Published dashboard/API port on the Docker host.
WEB_API_PUBLISHED_PORT=9121

# Use true behind HTTPS so cookies are Secure.
WEB_API_COOKIE_SECURE=false
WEB_API_COOKIE_SAMESITE=lax
WEB_API_COOKIE_MAX_AGE_SECONDS=43200

WEB_API_SESSION_CONTENDED_SECONDS=300
WEB_API_SESSION_HANDOFF_SECONDS=60
